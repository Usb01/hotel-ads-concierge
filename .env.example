# copy to .env and fill in what you need. Everything is optional for local runs.
DRY_RUN=1                      # 0 = actually send WhatsApp / email replies

META_VERIFY_TOKEN=pick-any-string
META_APP_SECRET=               # enables X-Hub-Signature-256 checks
META_PAGE_TOKEN=               # needed to fetch real lead details from the Graph API

GOOGLE_LEAD_KEY=pick-any-string

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

LLM_PROVIDER=none              # none | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
